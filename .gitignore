# ===========================================================================
# laPlayer - Git Distribution Config
# Ignore secrets, credentials, tokens, logs, and build outputs
# ===========================================================================

# Credentials, secrets & tokens (nunca commitar!)
credentials*.json
google*.json
cookies.txt
*.env
.env*
.backend.log
.backend.pid
.tunnel.log
.tunnel.pid
*.log
*.pid
start_server.sh

# Python & Node temporary caches
__pycache__/
*.pyc
node_modules/
.wwebjs_auth/
.wwebjs_cache/

# Flutter build outputs
mobile/build/
mobile/.dart_tool/
server/temp_downloads/
*.m4a
*.webm
*.ogg

# Whitelist distribution files & source code
!.gitignore
!README.md
!server_url.txt
!app-release.apk
