# ===========================================================================
# laPlayer - Git Distribution Config
# Ignore secrets, credentials, tokens, logs, and build outputs
# ===========================================================================

# Credentials, secrets & tokens (nunca commitar!)
credentials*.json
google*.json
cookies.txt
*.env
.env*
.backend.log
.backend.pid
.tunnel.log
.tunnel.pid
*.log
*.pid
start_server.sh

# Python & Node temporary caches
__pycache__/
*.pyc
node_modules/
.wwebjs_auth/
.wwebjs_cache/

# Flutter build outputs
mobile/build/
mobile/.dart_tool/
server/temp_downloads/
server/slskd-bin/
server/slskd-downloads/
server/slskd-incomplete/
server/slskd-shared/
server/slskd-data/
*.m4a
*.webm
*.ogg

# Whitelist distribution files & source code
!.gitignore
!README.md

# APK vai pra Release do GitHub (gh release create vX.Y.Z laplayer.apk; build_apk.sh)
*.apk

# Estado do servidor (estatística por chave, endereço do túnel): não é público
server/key_stats.json
server/key_downloads.log
server_url.txt
